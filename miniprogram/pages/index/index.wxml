<view class="screen {{v.cover?&#x27;cover&#x27;:&#x27;&#x27;}}">
 <image class="backdrop" src="/assets/painting.jpg" mode="aspectFill"></image>
 <view class="veil"></view>
 <view class="topbar"><button class="icon-button" bindtap="back" disabled="{{v.index===0}}" aria-label="返回上一页">‹</button><text class="brand">神韵山海 <text class="brand-dot">·</text> 女娲篇</text><button class="icon-button reset" bindtap="restart" aria-label="重新开始">↺</button></view>
 <view class="progress"><view style="width:{{v.progress}}%"></view></view>
 <view class="cover-content" wx:if="{{v.cover}}"><view class="eyebrow">山海绘卷 · 互动神话</view><view class="cover-title">神韵山海</view><view class="cover-sub">女 娲 篇</view><view class="seal">创造 · 守护</view><view class="cover-caption">捏一抔黄土，点亮万家灯火。<br></br>拾一枚彩石，守护一方山河。</view></view>
 <view class="content" wx:else="true">
  <view class="heading"><view class="eyebrow">{{v.child?&#x27;壹 · 创造生命&#x27;:v.id===&#x27;G2_01&#x27;||v.id===&#x27;G2_02&#x27;?&#x27;贰 · 古籍解谜&#x27;:v.id===&#x27;S13&#x27;?&#x27;叁 · 神话瞬间&#x27;:v.id===&#x27;S02_EXPLORE&#x27;?&#x27;山海经 · 博物志&#x27;:&#x27;女娲的神话画卷&#x27;}}<text class="counter">{{v.index+1}} / {{v.total}}</text></view><view class="title">{{v.title}}</view></view>
  <scroll-view class="reading" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" scroll-top="{{0}}">
   <view class="scene-art {{v.child?&#x27;has-child&#x27;:&#x27;&#x27;}} {{v.id===&#x27;S08&#x27;?&#x27;crisis&#x27;:&#x27;&#x27;}} {{shaking?&#x27;shaking&#x27;:&#x27;&#x27;}}" wx:if="{{v.id!==&#x27;S04&#x27; &amp;&amp; v.id!==&#x27;G2_01&#x27; &amp;&amp; v.id!==&#x27;S13&#x27; &amp;&amp; v.id!==&#x27;S14&#x27; &amp;&amp; v.id!==&#x27;S02_EXPLORE&#x27;}}" bindtap="shake">
    <image wx:if="{{!v.child}}" class="art" src="{{v.art}}" mode="aspectFill"></image>
    <view wx:if="{{v.child}}" class="child {{v.head}} {{v.color}}"><image class="child-body" src="/assets/child.png" mode="aspectFit"></image><view class="head-sprite"><image class="head-sheet" src="/assets/heads.png" style="left:{{v.headX}}%;top:{{v.headY}}%" mode="scaleToFill"></image></view></view>
    <view wx:if="{{v.miniChild}}" class="mini-child child {{v.head}} {{v.color}}"><image class="child-body" src="/assets/child.png" mode="aspectFit"></image><view class="head-sprite"><image class="head-sheet" src="/assets/heads.png" style="left:{{v.headX}}%;top:{{v.headY}}%" mode="scaleToFill"></image></view></view>
    <text class="art-note">{{v.child?v.wish:v.id===&#x27;S08&#x27;?&#x27;四极废，九州裂 · 点击感受天裂&#x27;:v.id===&#x27;S02&#x27;?&#x27;山经 · 海经 · 古人的想象之书&#x27;:&#x27;中国神话 · 原创画面演绎&#x27;}}</text>
   </view>
   <view class="narrator">{{v.narrator}}</view>
   <view class="age-hint" wx:if="{{v.hintText}}">{{v.hintText}}</view>
   <view class="choices {{v.child || v.id===&#x27;S13&#x27;?&#x27;compact&#x27;:&#x27;&#x27;}}" wx:if="{{v.options.length &amp;&amp; !(v.id===&#x27;S13&#x27; &amp;&amp; v.poster)}}"><button wx:for="{{v.options}}" wx:key="key" class="choice {{item.active?&#x27;selected&#x27;:&#x27;&#x27;}}" bindtap="pick" data-key="{{item.key}}"><view wx:if="{{item.shape}}" class="shape-icon {{item.shape}}"></view><view wx:if="{{item.swatch}}" class="color-swatch" style="background:{{item.swatch}}"></view><text class="choice-label">{{item.label}}</text><text class="choice-sub" wx:if="{{item.sub}}">{{item.sub}}</text><text class="tick" wx:if="{{item.active}}">✓</text></button></view>
   <view class="feedback" wx:if="{{v.feedback}}">{{v.feedback}}</view>
   <view wx:if="{{v.id===&#x27;S04&#x27;}}" class="books-wrap">
    <view class="book-guide">左右滑动古籍 · 已读 {{v.bookCount}} / 3</view>
    <swiper class="books" current="{{bookIndex}}" bindchange="bookChange" indicator-dots="{{true}}" indicator-active-color="#a86c38" previous-margin="14px" next-margin="14px">
     <swiper-item wx:for="{{v.books}}" wx:key="id"><view class="book"><view class="book-number">古籍摘读 · {{index+1}} <text wx:if="{{item.read}}">✓ 已读</text></view><view class="book-title">《{{item.title}}》</view><view class="source">{{item.source}}</view><view wx:if="{{bookOpen &amp;&amp; bookIndex===index}}"><view class="quote">{{item.quote}}</view><view class="meaning">{{item.meaning}}</view></view><view wx:else="true" class="book-decoration">卷</view><button class="book-toggle" bindtap="toggleBook" data-index="{{index}}">{{bookOpen &amp;&amp; bookIndex===index?&#x27;收起原文&#x27;:&#x27;展开 · 查看原文&#x27;}}</button></view></swiper-item>
    </swiper><view class="book-nav"><button class="text-button" data-step="-1" bindtap="turnBook">← 上一卷</button><text>{{bookIndex+1}} / 3</text><button class="text-button" data-step="1" bindtap="turnBook">下一卷 →</button></view><view class="footnote">三条材料各有来源，并非造人、补天的连续章节。原文使用简体字与现代标点。</view>
   </view>
   <view wx:if="{{v.id===&#x27;S02_EXPLORE&#x27;}}" class="exploration">
    <view class="map-toolbar"><text>已发现 {{v.seenCount}} / 14</text><button class="zoom" bindtap="zoomOut" disabled="{{mapScale===1}}" aria-label="缩小画卷">−</button><text>{{mapScale}}×</text><button class="zoom" bindtap="zoomIn" disabled="{{mapScale===3}}" aria-label="放大画卷">＋</button></view>
    <scroll-view class="map-viewport" scroll-x="{{true}}" scroll-y="{{true}}" enhanced="{{true}}"><view class="map-world" style="width:{{mapScale*100}}%;height:{{mapScale*260}}px"><image class="map-image" src="/assets/explore.jpg" mode="scaleToFill"></image><view class="cloud-drift"></view><view class="water-glow"></view><button wx:for="{{v.exhibits}}" wx:key="id" class="map-marker {{item.seen?&#x27;seen&#x27;:&#x27;&#x27;}}" style="left:{{item.x}}%;top:{{item.y}}%" data-key="{{item.id}}" bindtap="inspect" aria-label="观察{{item.name}}">{{item.number}}</button></view></scroll-view>
    <view class="map-caption">山林、水域与云间的想象画卷 · 可滑动移动</view>
    <view class="exhibit-tags"><button wx:for="{{v.exhibits}}" wx:key="id" class="exhibit-tag {{item.seen?&#x27;seen&#x27;:&#x27;&#x27;}}" data-key="{{item.id}}" bindtap="inspect">{{item.name}}<text wx:if="{{item.seen}}"> ✓</text></button></view>
    <view class="footnote">物象来自不同篇章，此图是汇集想象，不是同一地点的复原。生物、矿物外形为美术示意；文字据古籍摘录，传说不等于现实科学知识。</view>
   </view>
   <view wx:if="{{v.id===&#x27;G1_04&#x27;}}"><view class="badge">✦ 造人小匠</view><input class="input" maxlength="16" value="{{v.name}}" bindinput="nameInput" placeholder="给小伙伴起个名字（可跳过）"></input><button class="text-button" bindtap="openChat">与云启聊聊</button></view>
   <view wx:if="{{v.id===&#x27;G2_01&#x27;}}" class="sort-game"><view class="slots"><button wx:for="{{v.slots}}" wx:key="pos" class="slot {{item.filled?&#x27;filled&#x27;:&#x27;&#x27;}}" bindtap="undo" data-pos="{{item.pos}}"><text class="slot-number">{{item.pos+1}}</text>{{item.label}}<text wx:if="{{item.filled}}" class="remove">×</text></button></view><view class="task-bank"><button wx:for="{{v.tasks}}" wx:key="key" class="task" disabled="{{item.used}}" bindtap="task" data-key="{{item.key}}">{{item.label}}</button></view><view class="row"><button class="text-button" bindtap="clear">清空重排</button><button class="text-button" bindtap="hint">看提示</button></view><view class="feedback" wx:if="{{v.hint}}">{{v.attempts&gt;=3?v.original:&#x27;原文开头：炼五色石，以补苍天。&#x27;}}<view>排的是古籍文字的叙述次序。</view></view><button wx:if="{{v.attempts&gt;=3}}" class="secondary" bindtap="solve">查看原文顺序并填入</button></view>
   <view wx:if="{{v.id===&#x27;G2_02&#x27;}}"><view class="badge">✦ 神话整理师</view><view class="feedback">{{v.original}}</view></view>
   <view wx:if="{{v.id===&#x27;S11&#x27;||v.id===&#x27;S12&#x27;}}" class="badges"><text wx:if="{{v.game1}}">✦ 造人小匠</text><text wx:if="{{v.game2}}">✦ 神话整理师</text></view>
   <button wx:if="{{v.id===&#x27;S12&#x27;}}" class="text-button" bindtap="review">再看故事 · 保留作品</button>
   <view wx:if="{{v.id===&#x27;S13&#x27;}}">
    <view wx:if="{{!v.poster}}"><textarea class="description" value="{{v.description}}" bindinput="descriptionInput" maxlength="120" placeholder="用自己的话，描述你心中的神话画面……"></textarea><view class="char-count">{{v.description.length}} / 120 · 建议 10—120 字</view><button class="text-button" bindtap="useTemplate" disabled="{{!v.moment}}">试用这幕的描述例句</button><view class="demo-note">生图服务尚未接入。下面将打开项目提供的“女娲补天”示例，不根据输入实时绘图。</view><button class="secondary" bindtap="sample">查看示例海报（演示模式）</button></view>
    <view wx:else="true"><image class="poster" src="/assets/painting.jpg" mode="aspectFit" bindtap="preview"></image><view class="demo-note">示例图，并非本次实时生成<br></br>本次旅程保留同一张示例海报。</view><button class="secondary" bindtap="savePoster">保存示例海报</button></view>
   </view>
   <view wx:if="{{v.id===&#x27;S14&#x27;}}"><view class="badge">✦ 三项体验已完成</view><image class="end-poster" src="/assets/painting.jpg" mode="aspectFit"></image><view class="comic-grid"><view>壹 · 开端</view><view>贰 · 困难</view><view>叁 · 行动</view><view>肆 · 结局</view></view><button class="secondary" disabled="{{true}}">四格漫画工具 · 暂未接入</button><view class="footnote">四格漫画是选做拓展。未配置外部工具，不影响本次通关。海报为演示示例。</view></view>
   <view class="scroll-bottom"></view>
  </scroll-view>
 </view>
 <view class="bottom"><view class="notice" wx:if="{{notice}}">{{notice}}</view><button class="primary" disabled="{{!v.ready}}" bindtap="next">{{v.button}} <text>→</text></button><view class="bottom-line"><text class="saved">{{v.cover?&#x27;创造生命 · 守护世界&#x27;:&#x27;进度保存在本机&#x27;}}</text><button class="tutor-entry" bindtap="openChat"><view><text>AI助教 · 云启</text><text class="tutor-caption">点我聊一聊</text></view><image src="/assets/tutor.jpg" mode="aspectFill"></image></button></view></view>
 <view class="overlay exhibit-overlay" wx:if="{{exhibit}}" bindtap="closeExhibit"><view class="exhibit-panel" catchtap="noop"><view class="exhibit-header"><view><view class="eyebrow">山海博物 · 放大镜</view><view class="title">{{exhibit.name}}</view></view><button class="icon-button" bindtap="closeExhibit" aria-label="收起放大镜">×</button></view><view class="magnifier"><image class="lens-image" src="/assets/explore.jpg" style="left:{{exhibit.lensLeft}}px;top:{{exhibit.lensTop}}px" mode="scaleToFill"></image></view><view class="quote">“{{exhibit.quote}}”</view><view class="source">《山海经 · {{exhibit.chapter}}》· {{exhibit.place}}</view><view class="meaning">{{exhibit.explanation}}</view><view class="exhibit-note" wx:if="{{exhibit.id===&#x27;turtle&#x27;}}">原文先说“玄龟”，再说“其名曰旋龟”。</view><view class="exhibit-note" wx:if="{{exhibit.id===&#x27;migu&#x27;}}">名称亦写作“迷谷”“迷穀”。</view><view class="exhibit-note">图为想象演绎 · 原文简体摘录</view><button class="secondary" bindtap="closeExhibit">收起放大镜 · 继续探索</button></view></view>
 <view class="overlay" wx:if="{{chat}}" bindtap="closeChat"><view class="chat-panel" catchtap="noop"><view class="chat-header"><image src="/assets/tutor.jpg" mode="aspectFill"></image><view><view class="chat-name">云启</view><view class="source">你的山海同行人</view></view><button class="icon-button" bindtap="closeChat">×</button></view><view class="demo-note">演示对话 · 外接 AI 接口待接入</view><button class="question" bindtap="ask">你是谁？</button><view class="answer" wx:if="{{answered}}">我是你的助教云启，跟我一起探索神话世界吧。</view><view wx:else="true" class="chat-empty">点击上方问题，和云启打个招呼吧。</view><button class="secondary" bindtap="closeChat">收起对话 · 继续故事</button></view></view>
</view>
